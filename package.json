{
  "name": "lol-video-generator",
  "version": "1.0.0",
  "description": "Bilingual LoL data-to-video pipeline with guarded social publishing.",
  "scripts": {
    "dev": "next dev --webpack",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:coverage": "node scripts/runCoverage.js",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "tdd:doctor": "node scripts/tddDoctor.js",
    "verify": "npm run tdd:doctor && npm run test:coverage && npx next build",
    "qa:render": "node scripts/qaRender.js",
    "canary:post-match-read": "node scripts/renderPostMatchReadCanary.js",
    "publish:queue": "node scripts/publishQueue.js list",
    "publish:run": "node scripts/publishQueue.js run",
    "publish:due": "node scripts/publishQueue.js run --due",
    "publish:scheduler": "node scripts/publishScheduler.js",
    "insights:sync": "node scripts/insightsSync.js",
    "media:cleanup": "node scripts/cleanupMedia.js",
    "insights:scheduler": "node scripts/insightsScheduler.js",
    "portfolio:render": "node scripts/renderPortfolioEvidence.js",
    "portfolio:capture": "node scripts/capturePortfolioEvidence.js",
    "assets:inventory": "node scripts/esportsAssetInventory.js",
    "assets:import": "node scripts/importEsportsAssets.js",
    "assets:verify": "node scripts/verifyEsportsAssets.js"
  },
  "keywords": [
    "remotion",
    "nextjs",
    "content-automation",
    "league-of-legends"
  ],
  "author": "Hunter Tseng（曾尉庭）",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "2.16.0",
    "@remotion/cli": "4.0.489",
    "axios": "^1.15.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "node-cron": "^4.2.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remotion": "4.0.489",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.8.3"
  }
}
